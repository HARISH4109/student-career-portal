########################################
# GENERAL
########################################
NODE_ENV=development

########################################
# DATABASE (Supabase Postgres, accessed via Drizzle)
########################################
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/career_portal
# Supabase project connection (used by packages/db + apps/api)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me           # server-side only, never expose to client
SUPABASE_ANON_KEY=replace-me                   # safe for frontend

########################################
# AUTH
########################################
JWT_SECRET=replace-with-256-bit-secret          # used to verify Supabase-issued JWTs server-side

########################################
# REDIS (sessions, caching, rate limiting, BullMQ if added later)
########################################
REDIS_URL=redis://localhost:6379

########################################
# API (Express)
########################################
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

########################################
# N8N AI EXTRACTION AGENT (Optional)
########################################
N8N_EXTRACTION_WEBHOOK_URL=https://your-n8n-host/webhook/opportunity-extraction
N8N_WEBHOOK_SECRET=replace-with-shared-webhook-secret
N8N_ENCRYPTION_KEY=replace-with-n8n-encryption-key

########################################
# WEB (React/Vite)
########################################
VITE_API_BASE_URL=http://localhost:4000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-me
VITE_SOCKET_URL=http://localhost:4000

########################################
# AI SERVICE (FastAPI - Groq / NVIDIA NIM / OpenAI)
########################################
AI_SERVICE_PORT=8000
AI_SERVICE_BASE_URL=http://localhost:8000
# Active Provider Switch: "auto", "groq", "nvidia", or "openai"
AI_PROVIDER=auto

# Groq Cloud API Configuration (Recommended: Ultra-fast inference & high accuracy)
GROQ_API_KEY=gsk_replace_with_your_groq_api_key   # Get free key at https://console.groq.com
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile               # Or llama-3.1-8b-instant

# NVIDIA NIM Configuration (Alternative)
NVIDIA_API_KEY=nvapi-your-nvidia-nim-api-key   # Get free key at https://build.nvidia.com
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# OpenAI (Alternative Fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

AI_SERVICE_INTERNAL_TOKEN=replace-me            # shared secret so api <-> ai-service calls are authenticated

########################################
# EMAIL (Nodemailer)
########################################
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=replace-me
EMAIL_FROM="Career Portal <no-reply@careerportal.edu>"

########################################
# OBSERVABILITY / LOGGING
########################################
LOG_LEVEL=info

# Existing active faculty/admin UUID used to attribute the Phase 6 starter catalog.
# Leave empty to skip career catalog seeding; no privileged user is created.
CAREER_SEED_STAFF_USER_ID=
